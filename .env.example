FSOCIETY_TOKEN=
FSOCIETY_PREFIX=!

# Persistência do banco SQLite no Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fsociety-backups

# Opcional: intervalo de backup remoto em segundos (10-300).
FSOCIETY_BACKUP_INTERVAL=30

# Opcional: habilita pesquisa de músicas pelo catálogo do Spotify.
# Crie um app em https://developer.spotify.com/dashboard e use as credenciais abaixo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: monitor de commits do GitHub.
FSOCIETY_GITHUB_REPO=ZHOIKA/FSociety-bot-public
FSOCIETY_GITHUB_TOKEN=
